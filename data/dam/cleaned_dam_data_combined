import pandas as pd

file_path = 'data/dam/dam_data_combined.csv'
df = pd.read_csv(file_path)

if 'subbasin' in df.columns:
    df.drop(columns=['subbasin'], inplace=True)


if 'Storage' in df.columns:
    df['Storage'] = df['Storage'].interpolate(method='linear')
if 'Level' in df.columns:
    df['Level'] = df['Level'].interpolate(method='linear')

output_path = 'data\dam\dam_data_combined_modified.csv'
df.to_csv(output_path, index=False)

